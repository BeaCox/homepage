---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionRenderer from './SectionRenderer.astro';
import { getPageSections } from '../config/sections';
import avatar from '../assets/avatar.png';
import { profile, type Lang } from '../i18n/locales';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const isEnglish = lang === 'en';
const year = new Date().getFullYear();
const yearRange = String(profile.startYear) === String(year) ? String(year) : `${profile.startYear}–${year}`;

const sections = await getPageSections(lang);
const aboutSection = sections.find((section) => section.kind === 'about');
const contentSections = sections.filter((section) => section !== aboutSection);

if (!aboutSection) {
  throw new Error(`The ${lang} content directory must include one section with kind: about.`);
}

const AboutContent = aboutSection.Content;
const isHttpUrl = (url: string) => /^https?:\/\//i.test(url);

const socialIcons: Record<string, string> = {
  blog: '<path d="M5 3.5h11.5A2.5 2.5 0 0 1 19 6v14.5H7.5A2.5 2.5 0 0 1 5 18V3.5Z"/><path d="M8 7h7M8 11h7M8 15h4"/>',
  github: '<path d="M12 2.8a9.2 9.2 0 0 0-2.9 17.9c.5.1.6-.2.6-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-4.7 0-1 .4-1.9 1-2.5-.1-.3-.4-1.3.1-2.5 0 0 .8-.3 2.5 1a8.8 8.8 0 0 1 4.6 0c1.8-1.2 2.5-1 2.5-1 .5 1.2.2 2.2.1 2.5.7.7 1 1.5 1 2.5 0 3.6-2.4 4.4-4.6 4.7.4.3.7.9.7 1.8v2.7c0 .4.2.6.7.5A9.2 9.2 0 0 0 12 2.8Z"/>',
  email: '<path d="M3.5 6.5h17v11h-17z"/><path d="m4 7 8 6 8-6"/>',
  rss: '<path d="M5 5a14 14 0 0 1 14 14M5 10a9 9 0 0 1 9 9"/><circle cx="6" cy="18" r="1.2" fill="currentColor" stroke="none"/>',
  discord: '<path d="M8 7.5a10 10 0 0 1 8 0l1.5-1a13 13 0 0 1 3 9.5 10 10 0 0 1-3.5 2l-1.3-1.7M16 17a12 12 0 0 1-8 0l-1 1a10 10 0 0 1-3.5-2A13 13 0 0 1 6.5 6.5l1.5 1"/><circle cx="8.5" cy="13" r="1"/><circle cx="15.5" cy="13" r="1"/>',
};

const linkGroups = [
  profile.links.filter((link) => ['blog', 'rss'].includes(link.icon)),
  profile.links.filter((link) => ['github', 'email', 'discord'].includes(link.icon)),
];
---

<Layout title={t('site.title')} description={t('site.description')} lang={isEnglish ? 'en' : 'zh-CN'}>
  <nav class="topbar" aria-label={isEnglish ? 'Primary navigation' : '主导航'}>
    <div class="topbar-inner">
      <a class="topbar-brand" href={isEnglish ? '/en/' : '/'}>{profile.handle}</a>

      <div class="topbar-actions">
        <a class="topbar-btn language-switch" href={isEnglish ? '/' : '/en/'} aria-label={t('lang.switchTitle')}>
          {t('lang.switch')}
        </a>
        <button class="topbar-btn theme-toggle" type="button" id="theme-toggle" aria-label={t('theme.dark')}>
          <svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="3.5" />
            <path d="M12 2v2.2M12 19.8V22M4.93 4.93l1.56 1.56M17.51 17.51l1.56 1.56M2 12h2.2M19.8 12H22M4.93 19.07l1.56-1.56M17.51 6.49l1.56-1.56" />
          </svg>
          <svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.5 15.1A8.4 8.4 0 0 1 8.9 3.5 8.7 8.7 0 1 0 20.5 15.1Z" />
          </svg>
        </button>
      </div>
    </div>

    <div class="mobile-nav">
      {sections.map((section) => (
        <>
          <a class="mobile-nav-link" href={`#${section.id}`} data-mobile-link data-section={section.id}>
            {section.title}
          </a>
          {section.subsections?.map((subsection) => (
            <a
              class="mobile-nav-sublink"
              href={`#${subsection.id}`}
              data-mobile-subsection
              data-parent-section={section.id}
              data-subsection={subsection.id}
              tabindex="-1"
            >
              {subsection.title}
            </a>
          ))}
        </>
      ))}
    </div>
  </nav>

  <main class="page-shell">
    <section id="about" class="profile-layout" data-reveal data-section-id="about">
      <aside class="profile-card">
        <Image
          class="profile-avatar"
          src={avatar}
          alt={profile.handle}
          widths={[100, 104, 112]}
          sizes="(max-width: 640px) 104px, (max-width: 820px) 112px, 100px"
          loading="eager"
          fetchpriority="high"
        />
        <div class="profile-copy">
          <h1>{profile.handle}</h1>
          <p class="profile-role">{t('hero.role')}</p>
          <p class="profile-affiliation">{t('hero.affiliation')}</p>
          <p class="profile-motto">{profile.motto}</p>
        </div>

        <div class="author-link-groups">
          {linkGroups.map((links) => (
            <ul class="author-links">
              {links.map((link) => {
                const opensInNewTab = isHttpUrl(link.url);

                return (
                  <li>
                    <a
                      class="author-link"
                      href={link.url}
                      target={opensInNewTab ? '_blank' : undefined}
                      rel={opensInNewTab ? 'noopener noreferrer' : undefined}
                      aria-label={link.label}
                      title={link.label}
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcons[link.icon]} />
                    </a>
                  </li>
                );
              })}
            </ul>
          ))}
        </div>

        <a
          class="resume-download"
          href="/resume.pdf"
          download="BeaCox-Resume.pdf"
          aria-label={t('resume.download')}
        >
          <span>{t('resume.label')}</span>
          <span aria-hidden="true">↓</span>
        </a>

        <div class="side-directory">
          <p>{isEnglish ? 'Contents' : '目录'}</p>
          <nav class="side-nav" data-nav-root aria-label={isEnglish ? 'Section navigation' : '章节目录'}>
            <span class="side-nav-indicator" data-nav-indicator aria-hidden="true"></span>
            {sections.map((section) => (
              <div class="side-nav-item" data-nav-item data-section={section.id}>
                <a
                  class="side-nav-link"
                  href={`#${section.id}`}
                  data-nav-link
                  data-section={section.id}
                  aria-expanded={section.subsections?.length ? 'false' : undefined}
                >
                  <strong>{section.title}</strong>
                </a>
                {section.subsections?.length ? (
                  <div class="side-nav-submenu" data-nav-submenu aria-hidden="true">
                    <div class="side-nav-submenu-inner">
                      {section.subsections.map((subsection) => (
                        <a
                          class="side-nav-sublink"
                          href={`#${subsection.id}`}
                          data-nav-subsection
                          data-parent-section={section.id}
                          data-subsection={subsection.id}
                          tabindex="-1"
                        >
                          {subsection.title}
                        </a>
                      ))}
                    </div>
                  </div>
                ) : null}
              </div>
            ))}
          </nav>
        </div>
      </aside>

      <div class="profile-main">
        <header class="section-intro">
          <h2>{aboutSection.title}</h2>
        </header>
        <div class="markdown-content markdown-content--about">
          <AboutContent />
        </div>
      </div>
    </section>

    <div class="sections">
      {contentSections.map((section) => <SectionRenderer section={section} />)}
    </div>
  </main>

  <footer class="site-footer">
    <p class="footer-copyright">&copy; {yearRange} <a href={profile.url}>{profile.handle}</a></p>
    <a class="footer-source" href={profile.sourceUrl} target="_blank" rel="noopener noreferrer">
      {t('footer.source')}
    </a>
    <p class="footer-motto">{profile.motto}</p>
  </footer>
</Layout>

<script is:inline define:vars={{ lightLabel: t('theme.light'), darkLabel: t('theme.dark') }}>
  (() => {
    const root = document.documentElement;
    const themeButton = document.getElementById('theme-toggle');
    const themeColor = document.getElementById('theme-color');
    const colorScheme = window.matchMedia('(prefers-color-scheme: dark)');
    const navLinks = [...document.querySelectorAll('[data-nav-link]')];
    const subsectionLinks = [...document.querySelectorAll('[data-nav-subsection]')];
    const mobileLinks = [...document.querySelectorAll('[data-mobile-link]')];
    const mobileSubsectionLinks = [...document.querySelectorAll('[data-mobile-subsection]')];
    const sections = [...document.querySelectorAll('[data-section-id]')];
    const navRoot = document.querySelector('[data-nav-root]');
    const navIndicator = document.querySelector('[data-nav-indicator]');
    const profileCard = document.querySelector('.profile-card');
    let cancelInitialAlignment = () => {};

    const getScrollBehavior = () => (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
    );

    const isDark = () => {
      const selected = root.getAttribute('data-theme');
      if (selected) return selected === 'dark';
      return colorScheme.matches;
    };

    const updateThemeButton = () => {
      if (!themeButton) return;
      themeButton.setAttribute('aria-label', isDark() ? lightLabel : darkLabel);
      themeColor?.setAttribute('content', isDark() ? '#10101a' : '#f7f7fc');
    };

    themeButton?.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateThemeButton();
    });
    updateThemeButton();
    colorScheme.addEventListener('change', () => {
      if (!root.hasAttribute('data-theme')) updateThemeButton();
    });

    const getCurrentSubsectionId = (sectionId) => {
      const links = subsectionLinks.filter(
        (link) => link.getAttribute('data-parent-section') === sectionId
      );
      if (!links.length) return '';

      const marker = window.innerHeight * 0.28;
      let current = links[0];

      links.forEach((link) => {
        const target = document.getElementById(link.getAttribute('data-subsection') || '');
        if (target?.getBoundingClientRect().top <= marker) current = link;
      });

      return current?.getAttribute('data-subsection') || '';
    };

    const positionNavIndicator = () => {
      const active = navLinks.find((link) => link.hasAttribute('data-active'));
      if (!active || !navRoot || !navIndicator) return;

      const activeRect = active.getBoundingClientRect();
      const navRect = navRoot.getBoundingClientRect();
      navIndicator.style.height = `${activeRect.height}px`;
      navIndicator.style.transform = `translateY(${activeRect.top - navRect.top}px)`;
      navIndicator.style.opacity = '1';

      const activeSubsection = subsectionLinks.find((link) => link.hasAttribute('data-active'));
      const visibleTarget = activeSubsection || active;
      const visibleTargetRect = visibleTarget.getBoundingClientRect();
      if (profileCard) {
        const cardRect = profileCard.getBoundingClientRect();
        const visibleTop = cardRect.top + 12;
        const visibleBottom = cardRect.bottom - 12;
        let scrollDelta = 0;

        if (visibleTargetRect.top < visibleTop) {
          scrollDelta = visibleTargetRect.top - visibleTop;
        } else if (visibleTargetRect.bottom > visibleBottom) {
          scrollDelta = visibleTargetRect.bottom - visibleBottom;
        }

        if (scrollDelta) {
          profileCard.scrollTo({
            top: profileCard.scrollTop + scrollDelta,
            behavior: 'auto',
          });
        }
      }
    };

    const setActive = (id, behavior = getScrollBehavior(), subsectionId = getCurrentSubsectionId(id)) => {
      [...navLinks, ...mobileLinks].forEach((link) => {
        link.toggleAttribute('data-active', link.getAttribute('data-section') === id);
      });
      document.querySelectorAll('[data-nav-item]').forEach((item) => {
        const expanded = item.getAttribute('data-section') === id && Boolean(
          item.querySelector('[data-nav-submenu]')
        );
        item.toggleAttribute('data-expanded', expanded);

        const parentLink = item.querySelector('[data-nav-link]');
        const submenu = item.querySelector('[data-nav-submenu]');
        if (parentLink?.hasAttribute('aria-expanded')) {
          parentLink.setAttribute('aria-expanded', String(expanded));
        }
        submenu?.setAttribute('aria-hidden', String(!expanded));
        item.querySelectorAll('[data-nav-subsection]').forEach((link) => {
          link.setAttribute('tabindex', expanded ? '0' : '-1');
        });
      });
      subsectionLinks.forEach((link) => {
        link.toggleAttribute(
          'data-active',
          link.getAttribute('data-parent-section') === id &&
            link.getAttribute('data-subsection') === subsectionId
        );
      });
      mobileSubsectionLinks.forEach((link) => {
        const expanded = link.getAttribute('data-parent-section') === id;
        link.toggleAttribute('data-expanded', expanded);
        link.toggleAttribute(
          'data-active',
          expanded && link.getAttribute('data-subsection') === subsectionId
        );
        link.setAttribute('tabindex', expanded ? '0' : '-1');
      });
      const activeMobile = mobileLinks.find((link) => link.getAttribute('data-section') === id);
      const activeMobileSubsection = mobileSubsectionLinks.find(
        (link) => link.hasAttribute('data-active')
      );
      const mobileTarget = activeMobileSubsection?.offsetParent ? activeMobileSubsection : activeMobile;
      if (mobileTarget?.offsetParent) {
        const mobileNav = mobileTarget.closest('.mobile-nav');
        const left = mobileTarget.offsetLeft - ((mobileNav?.clientWidth || 0) - mobileTarget.offsetWidth) / 2;
        mobileNav?.scrollTo({
          left: Math.max(0, left),
          behavior,
        });
      }
      positionNavIndicator();
    };

    if ('ResizeObserver' in window && navRoot) {
      new ResizeObserver(positionNavIndicator).observe(navRoot);
    }

    const getCurrentSectionId = () => {
      const marker = window.innerHeight * 0.28;
      let current = sections[0];

      sections.forEach((section) => {
        if (section.getBoundingClientRect().top <= marker) current = section;
      });

      return current?.getAttribute('data-section-id');
    };

    let spyFrame = 0;
    let navigationTargetId = '';
    let navigationEndTimer = 0;

    const finishNavigation = () => {
      navigationTargetId = '';
      navigationEndTimer = 0;
      setActive(getCurrentSectionId() || 'about');
    };

    const scheduleNavigationEnd = () => {
      window.clearTimeout(navigationEndTimer);
      navigationEndTimer = window.setTimeout(finishNavigation, 180);
    };

    const updateActiveFromScroll = () => {
      if (navigationTargetId) {
        scheduleNavigationEnd();
        return;
      }
      if (spyFrame) return;
      spyFrame = requestAnimationFrame(() => {
        spyFrame = 0;
        setActive(getCurrentSectionId() || 'about');
      });
    };

    const getDocumentTop = (element) => (
      element.getBoundingClientRect().top + window.scrollY
    );

    const scrollToSection = (id, behavior = getScrollBehavior(), parentId = id) => {
      const target = document.getElementById(id);
      if (!target) return false;

      const scrollPadding = Number.parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
      const top = getDocumentTop(target) - scrollPadding;
      navigationTargetId = behavior === 'smooth' ? parentId : '';
      window.scrollTo({ top: Math.max(0, top), behavior });
      setActive(parentId, behavior, id === parentId ? getCurrentSubsectionId(parentId) : id);
      if (navigationTargetId) scheduleNavigationEnd();
      return true;
    };

    document.addEventListener('click', (event) => {
      if (
        event.defaultPrevented ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) return;

      const link = event.target instanceof Element
        ? event.target.closest(
          '[data-nav-link], [data-nav-subsection], [data-mobile-link], [data-mobile-subsection]'
        )
        : null;
      const id = link?.getAttribute('href')?.slice(1);
      if (!id || !document.getElementById(id)) return;

      const parentId = link.getAttribute('data-parent-section') || id;

      event.preventDefault();
      cancelInitialAlignment();
      history.pushState(null, '', `#${id}`);
      scrollToSection(id, getScrollBehavior(), parentId);
    });

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.setAttribute('data-visible', '');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });

    document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));
    document.documentElement.classList.add('motion-ready');

    window.addEventListener('scroll', updateActiveFromScroll, { passive: true });

    const initial = window.location.hash.slice(1);
    const initialParent = subsectionLinks.find(
      (link) => link.getAttribute('data-subsection') === initial
    )?.getAttribute('data-parent-section') || initial;
    if (initial && scrollToSection(initial, 'auto', initialParent)) {
      let alignmentActive = true;
      const alignInitialHash = () => {
        if (alignmentActive) scrollToSection(initial, 'auto', initialParent);
      };
      const alignmentTimers = [
        window.setTimeout(alignInitialHash, 140),
        window.setTimeout(alignInitialHash, 420),
      ];
      const handleLoad = () => alignInitialHash();

      cancelInitialAlignment = () => {
        alignmentActive = false;
        alignmentTimers.forEach((timer) => window.clearTimeout(timer));
        window.removeEventListener('load', handleLoad);
      };

      requestAnimationFrame(() => requestAnimationFrame(alignInitialHash));
      if (document.readyState !== 'complete') {
        window.addEventListener('load', handleLoad, { once: true });
      }
    } else {
      setActive(getCurrentSectionId() || 'about');
    }
    updateActiveFromScroll();

    window.addEventListener('resize', updateActiveFromScroll);
  })();
</script>
