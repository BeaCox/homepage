---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionRenderer from './SectionRenderer.astro';
import { getPageSections } from '../config/sections';
import avatar from '../assets/avatar.png';
import sailing from '../assets/sailing.webp';
import { profile, type Lang } from '../i18n/locales';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const isEnglish = lang === 'en';
const year = new Date().getFullYear();
const yearRange = String(profile.startYear) === String(year) ? String(year) : `${profile.startYear}–${year}`;

const sections = await getPageSections(lang);
const aboutSection = sections.find((section) => section.kind === 'about');
const contentSections = sections.filter((section) => section !== aboutSection);

if (!aboutSection) {
  throw new Error(`The ${lang} content directory must include one section with kind: about.`);
}

const AboutContent = aboutSection.Content;
const isHttpUrl = (url: string) => /^https?:\/\//i.test(url);

const socialIcons: Record<string, string> = {
  blog: '<path d="M5 3.5h11.5A2.5 2.5 0 0 1 19 6v14.5H7.5A2.5 2.5 0 0 1 5 18V3.5Z"/><path d="M8 7h7M8 11h7M8 15h4"/>',
  github: '<path d="M12 2.8a9.2 9.2 0 0 0-2.9 17.9c.5.1.6-.2.6-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 2.9.9.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-4.7 0-1 .4-1.9 1-2.5-.1-.3-.4-1.3.1-2.5 0 0 .8-.3 2.5 1a8.8 8.8 0 0 1 4.6 0c1.8-1.2 2.5-1 2.5-1 .5 1.2.2 2.2.1 2.5.7.7 1 1.5 1 2.5 0 3.6-2.4 4.4-4.6 4.7.4.3.7.9.7 1.8v2.7c0 .4.2.6.7.5A9.2 9.2 0 0 0 12 2.8Z"/>',
  email: '<path d="M3.5 6.5h17v11h-17z"/><path d="m4 7 8 6 8-6"/>',
  rss: '<path d="M5 5a14 14 0 0 1 14 14M5 10a9 9 0 0 1 9 9"/><circle cx="6" cy="18" r="1.2" fill="currentColor" stroke="none"/>',
  discord: '<path d="M8 7.5a10 10 0 0 1 8 0l1.5-1a13 13 0 0 1 3 9.5 10 10 0 0 1-3.5 2l-1.3-1.7M16 17a12 12 0 0 1-8 0l-1 1a10 10 0 0 1-3.5-2A13 13 0 0 1 6.5 6.5l1.5 1"/><circle cx="8.5" cy="13" r="1"/><circle cx="15.5" cy="13" r="1"/>',
};

const blog = profile.links.find((link) => link.icon === 'blog')!;
const contactLinks = profile.links.filter((link) => link !== blog);
---

<Layout title={t('site.title')} description={t('site.description')} lang={isEnglish ? 'en' : 'zh-CN'}>
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="#top">
        {profile.handle}
      </a>
      <div class="chapter-navigation">
        <nav class="chapter-nav" aria-label={isEnglish ? 'Contents' : '章节导航'}>
          {sections.map((section) => (
            <>
              <a href={`#${section.id}`} aria-current={section === aboutSection ? 'location' : undefined}>
                {section.shortTitle && section.shortTitle !== section.title ? (
                  <>
                    <span class="nav-label-full">{section.title}</span>
                    <span class="nav-label-short">{section.shortTitle}</span>
                  </>
                ) : (
                  section.title
                )}
              </a>
              {section.subsections?.map((sub) => (
                <a href={`#${sub.id}`} data-parent={section.id} hidden>{sub.title}</a>
              ))}
            </>
          ))}
        </nav>
      </div>
      <div class="preferences">
        <a href={isEnglish ? '/' : '/en/'} aria-label={t('lang.switchTitle')} class="language-switch">
          {t('lang.switch')}
        </a>
        <button type="button" id="theme-toggle" aria-label={t('theme.dark')}>
          <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.1A8.4 8.4 0 0 1 8.9 3.5 8.7 8.7 0 1 0 20.5 15.1Z"/></svg>
          <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main class="container">
    <section id={aboutSection.id} class="hero" data-section>
      <div class="hero-copy">
        <header class="identity">
          <Image class="avatar" src={avatar} width={184} height={184} alt={isEnglish ? 'BeaCox’s avatar' : 'BeaCox 的头像'} loading="eager" />
          <div>
            <h1>{profile.handle}</h1>
            <p class="role">{t('hero.affiliation')} · {t('hero.role')}</p>
          </div>
        </header>
        <div class="bio markdown-content"><AboutContent /></div>
        <div class="hero-actions">
          <a class="action primary" href={blog.url} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcons.blog} />
            {isEnglish ? 'Read my blog' : '阅读博客'}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="action" href="/resume.pdf" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6m-6 4h6"/></svg>
            {t('resume.view')}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="contact-links">
          {contactLinks.map((link) => {
            const email = link.icon === 'email' ? link.url.replace(/^mailto:/, '') : undefined;
            return (
              <>
                <a href={link.url} data-email={email} target={isHttpUrl(link.url) ? '_blank' : undefined} rel={isHttpUrl(link.url) ? 'noopener noreferrer' : undefined}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcons[link.icon]} />
                  {link.label}
                </a>
                {email && (
                  <button type="button" class="copy-email" aria-label={`${link.label} · ${t('contact.copyEmail')}`} title={`${t('contact.copyEmail')} (${email})`} hidden>
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcons.email} />
                    <span class="email-label">
                      {link.label}
                      <span class="email-copied" aria-hidden="true">{t('contact.copied')}</span>
                    </span>
                    <svg class="copy-hint" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  </button>
                )}
              </>
            );
          })}
        </div>
        <p class="email-status" role="status"></p>
      </div>

      <figure class="postcard">
        <Image src={sailing} alt={isEnglish ? 'A wooden sailboat with a rust-colored sail on open water' : '一艘张着赭红色风帆的木船驶过海面'}
          widths={[480, 800, 1100]} sizes="(max-width: 740px) 90vw, 40vw" loading="eager" fetchpriority="high" />
        <figcaption>
          <span>{profile.motto}</span>
          <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12"/><path d="m22 9-4 9-8 5 4-10Z"/><path d="m14 13 4 5M16 1v5m0 20v5M1 16h5m20 0h5"/></svg>
        </figcaption>
      </figure>
    </section>

    {contentSections.map((section) => <SectionRenderer section={section} />)}
  </main>

  <footer class="container site-footer">
    <span>© {yearRange} <a href={profile.url}>{profile.handle}</a></span>
    <div class="footer-links">
      <a href="#top">{t('footer.top')} ↑</a>
      <a href={profile.sourceUrl} target="_blank" rel="noopener noreferrer">{t('footer.source')} ↗</a>
    </div>
  </footer>
</Layout>

<script is:inline define:vars={{ lightLabel: t('theme.light'), darkLabel: t('theme.dark'), emailCopied: t('contact.emailCopied'), copyFailed: t('contact.copyFailed') }}>
  const root = document.documentElement;
  const scheme = matchMedia('(prefers-color-scheme: dark)');
  const button = document.getElementById('theme-toggle');
  function syncTheme() {
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : scheme.matches;
    button.setAttribute('aria-label', dark ? lightLabel : darkLabel);
    document.getElementById('theme-color').content = dark ? '#20221f' : '#faf9f5';
    return dark;
  }
  button.addEventListener('click', () => {
    root.dataset.theme = syncTheme() ? 'light' : 'dark';
    syncTheme();
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
  });
  syncTheme();
  scheme.addEventListener('change', syncTheme);

  const copyButton = document.querySelector('.copy-email');
  const emailLink = document.querySelector('[data-email]');
  if (copyButton && emailLink && navigator.clipboard?.writeText) {
    const status = document.querySelector('.email-status');
    const email = emailLink.dataset.email;
    let feedbackTimer;
    emailLink.hidden = true;
    copyButton.hidden = false;
    function resetFeedback() {
      copyButton.removeAttribute('data-copied');
      status.textContent = '';
      status.removeAttribute('data-error');
    }
    copyButton.addEventListener('click', async () => {
      let copied = false;
      try {
        await navigator.clipboard.writeText(email);
        copied = true;
      } catch {}
      clearTimeout(feedbackTimer);
      copyButton.toggleAttribute('data-copied', copied);
      status.toggleAttribute('data-error', !copied);
      status.textContent = copied ? emailCopied : `${copyFailed} · ${email}`;
      feedbackTimer = setTimeout(resetFeedback, copied ? 1800 : 7000);
    });
  }

  const nav = document.querySelector('.chapter-nav');
  const links = [...nav.querySelectorAll('a')];
  const targets = links.map((link) => document.getElementById(link.hash.slice(1)));
  let lastActive;
  let pendingLink = null;
  let pendingTimer = 0;

  function updateNavEdges() {
    nav.toggleAttribute('data-scroll-start', nav.scrollLeft > 1);
    nav.toggleAttribute('data-scroll-end', nav.scrollWidth - nav.clientWidth - nav.scrollLeft > 1);
  }
  function setActiveLink(active) {
    if (!active || active === lastActive) return;
    const chapter = active.dataset.parent || active.hash.slice(1);
    for (const link of links) {
      link.hidden = Boolean(link.dataset.parent && link.dataset.parent !== chapter);
      link.toggleAttribute('data-in-chapter', link.hash === `#${chapter}`);
      if (link === active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
    if (nav.scrollWidth > nav.clientWidth) {
      const targetLeft = nav.scrollLeft + active.getBoundingClientRect().left - nav.getBoundingClientRect().left - (nav.clientWidth - active.offsetWidth) / 2;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      nav.scrollTo({ left: targetLeft, behavior: reduceMotion ? 'auto' : 'smooth' });
    }
    updateNavEdges();
    lastActive = active;
  }
  function clearPending() {
    pendingLink = null;
    clearTimeout(pendingTimer);
  }
  function markChapter() {
    // Match native fragment navigation, allowing for subpixel scroll rounding.
    const navOffset = parseFloat(getComputedStyle(root).scrollPaddingTop) + 1;
    if (pendingLink) {
      const target = targets[links.indexOf(pendingLink)];
      const top = target?.getBoundingClientRect().top ?? 0;
      if (Math.abs(top - navOffset) > 6) return;
      clearPending();
    }
    const marker = navOffset + 24;
    let active = links[0];
    for (const [i, target] of targets.entries()) {
      if (target && target.getBoundingClientRect().top <= marker) active = links[i];
    }
    const atTop = window.scrollY <= 1;
    const atBottom = window.scrollY + window.innerHeight >= root.scrollHeight - 1;
    if (atTop || atBottom) {
      const index = links.findIndex((link) => link.hash === location.hash);
      const top = targets[index]?.getBoundingClientRect().top;
      // Keep an explicitly chosen anchor when the page edge limits scrolling.
      const clamped = atTop ? top <= navOffset : top >= navOffset - 2;
      active = clamped ? links[index] : atTop ? links[0] : links.at(-1);
    }
    setActiveLink(active);
  }
  for (const link of links) {
    link.addEventListener('click', () => {
      pendingLink = link;
      clearTimeout(pendingTimer);
      pendingTimer = setTimeout(clearPending, 900);
      setActiveLink(link);
    });
  }
  let scrollRaf = 0;
  function onScroll() {
    if (scrollRaf) return;
    scrollRaf = requestAnimationFrame(() => {
      scrollRaf = 0;
      markChapter();
    });
  }
  window.addEventListener('wheel', clearPending, { passive: true });
  window.addEventListener('touchstart', clearPending, { passive: true });
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => {
    markChapter();
    updateNavEdges();
  });
  window.addEventListener('pageshow', markChapter);
  window.addEventListener('hashchange', markChapter);
  nav.addEventListener('scroll', updateNavEdges, { passive: true });
  document.fonts.ready.then(updateNavEdges);
</script>
