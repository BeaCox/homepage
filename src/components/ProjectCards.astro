---
import { Image, type ImageMetadata } from 'astro:assets';
import { formatStars, langColors } from '../config/project-meta';
import type { ProjectItem } from '../config/sections';

interface Props {
  projects: ProjectItem[];
}

const { projects } = Astro.props;
const projectLogos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/*.{avif,gif,jpeg,jpg,png,svg,webp}',
  { eager: true },
);

const getProjectLogo = (logo?: string) => logo
  ? projectLogos[`../assets/projects/${logo}`]?.default
  : undefined;
---

<div class="project-grid">
  {projects.map((p) => {
    const logo = getProjectLogo(p.logo);

    return (
    <a
      class="project-card"
      href={`https://github.com/${p.repo}`}
      target="_blank"
      rel="noopener noreferrer"
      data-repo={p.repo}
    >
      <div class="project-art">
        {logo && (
          <Image
            class="project-logo"
            src={logo}
            alt=""
            width="160"
            height="160"
            loading="lazy"
            format="webp"
          />
        )}
        <svg class="project-arrow" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 17L17 7M17 7H8M17 7v9" />
        </svg>
      </div>
      <div class="project-body">
        <h3 class="project-name">{p.repo.split('/')[1]}</h3>
        <p class="project-desc">{p.description}</p>
        <div class="project-meta">
          <span class="project-stars">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
            </svg>
            <span data-stars>{formatStars(p.stars)}</span>
          </span>
          <span class="project-lang" hidden={!p.language}>
            <span
              class="project-lang-dot"
              data-lang-dot
              style={`background:${langColors[p.language ?? ''] || '#888'}`}
            />
            <span data-lang-name>{p.language}</span>
          </span>
        </div>
        <div class="project-topics" data-topics hidden={!p.topics.length}>
          {p.topics.slice(0, 4).map((t) => (
            <span class="project-topic">{t}</span>
          ))}
        </div>
      </div>
    </a>
    );
  })}
</div>

<script>
  import { formatStars, langColors } from '../config/project-meta';

  interface Metadata {
    stars: number;
    language: string | null;
    topics: string[];
  }

  async function refreshCards() {
    try {
      const response = await fetch('/api/projects.json', { signal: AbortSignal.timeout(6500) });
      if (!response.ok) return;
      const metadata: Record<string, Metadata> = await response.json();
      for (const card of document.querySelectorAll<HTMLElement>('.project-card[data-repo]')) {
        const data = metadata[card.dataset.repo!];
        if (!data) continue;

        card.querySelector('[data-stars]')!.textContent = formatStars(data.stars);
        const language = card.querySelector<HTMLElement>('.project-lang')!;
        language.hidden = !data.language;
        if (data.language) {
          language.querySelector('[data-lang-name]')!.textContent = data.language;
          language.querySelector<HTMLElement>('[data-lang-dot]')!.style.background = langColors[data.language] ?? '#888';
        }
        const topics = card.querySelector<HTMLElement>('[data-topics]')!;
        topics.hidden = !data.topics.length;
        topics.replaceChildren(...data.topics.map((name) => {
          const tag = document.createElement('span');
          tag.className = 'project-topic';
          tag.textContent = name;
          return tag;
        }));
      }
    } catch {
      // The Markdown metadata is already in the page.
    }
  }

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        observer.disconnect();
        void refreshCards();
      }
    }, { rootMargin: '320px' });
    document.querySelectorAll('.project-grid').forEach((grid) => observer.observe(grid));
  } else {
    void refreshCards();
  }
</script>
