---
import { Image, type ImageMetadata } from 'astro:assets';
import type { ProjectItem } from '../config/sections';

interface Props {
  projects: ProjectItem[];
}

const { projects } = Astro.props;
const projectLogos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/*.{avif,gif,jpeg,jpg,png,svg,webp}',
  { eager: true },
);

const formatStars = (n?: number) => typeof n === 'number'
  ? (n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n))
  : '–';

const getProjectLogo = (logo?: string) => logo
  ? projectLogos[`../assets/projects/${logo}`]?.default
  : undefined;

const langColors: Record<string, string> = {
  Swift: '#F05138',
  TypeScript: '#3178C6',
  JavaScript: '#F7DF1E',
  Python: '#3572A5',
  Go: '#00ADD8',
  Rust: '#DEA584',
  C: '#555555',
  'C++': '#F34B7D',
  Java: '#B07219',
  Shell: '#89E051',
  Kotlin: '#A97BFF',
};

---

<div class="project-grid">
  {projects.map((p) => {
    const logo = getProjectLogo(p.logo);

    return (
    <a
      class="project-card"
      href={`https://github.com/${p.repo}`}
      target="_blank"
      rel="noopener noreferrer"
      data-repo={p.repo}
    >
      {logo && (
        <Image
          class="project-logo"
          src={logo}
          alt={p.repo.split('/')[1]}
          width="48"
          height="48"
          loading="lazy"
          format="webp"
        />
      )}
      <div class="project-body">
        <h3 class="project-name">
          {p.repo.split('/')[1]}
          <svg class="project-arrow" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17L17 7M17 7H8M17 7v9" />
          </svg>
        </h3>
        <div class="project-meta">
          <span class="project-stars">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
            </svg>
            <span data-stars>{formatStars(p.stars)}</span>
          </span>
          {p.language && (
            <span class="project-lang">
              <span
                class="project-lang-dot"
                data-lang-dot
                style={`background:${langColors[p.language] || '#888'}`}
              />
              <span data-lang-name>{p.language}</span>
            </span>
          )}
        </div>
        <p class="project-desc">{p.description}</p>
        {p.topics.length > 0 && (
          <div class="project-topics" data-topics>
            {p.topics.slice(0, 4).map((t) => (
              <span class="project-topic">{t}</span>
            ))}
          </div>
        )}
      </div>
    </a>
    );
  })}
</div>

<script is:inline>
  (() => {
    const colors = {
      Swift:'#F05138',TypeScript:'#3178C6',JavaScript:'#F7DF1E',
      Python:'#3572A5',Go:'#00ADD8',Rust:'#DEA584',C:'#555555',
      'C++':'#F34B7D',Java:'#B07219',Shell:'#89E051',Kotlin:'#A97BFF'
    };
    const CACHE_TTL = 12 * 60 * 60 * 1000;
    const FETCH_TIMEOUT = 2000;

    function fmt(n) { return n >= 1000 ? (n/1000).toFixed(1)+'k' : String(n); }
    function cacheKey(repo) { return 'github-repo-meta:' + repo; }

    function updateCard(card, d) {
      var s = card.querySelector('[data-stars]');
      if (s && typeof d.stargazers_count === 'number') s.textContent = fmt(d.stargazers_count);

      if (d.language) {
        var ln = card.querySelector('[data-lang-name]');
        var ld = card.querySelector('[data-lang-dot]');
        if (ln) ln.textContent = d.language;
        if (ld) ld.style.background = colors[d.language] || '#888';
      }

      var tp = card.querySelector('[data-topics]');
      if (tp && d.topics && d.topics.length) {
        tp.textContent = '';
        d.topics.slice(0, 4).forEach(function(t) {
          var item = document.createElement('span');
          item.className = 'project-topic';
          item.textContent = t;
          tp.appendChild(item);
        });
      }
    }

    function readCache(repo, card) {
      try {
        var cached = JSON.parse(localStorage.getItem(cacheKey(repo)) || 'null');
        if (!cached || !cached.data) return false;
        updateCard(card, cached.data);
        return Date.now() - cached.time < CACHE_TTL;
      } catch (_) {
        return false;
      }
    }

    function writeCache(repo, data) {
      try {
        localStorage.setItem(cacheKey(repo), JSON.stringify({ time: Date.now(), data: data }));
      } catch (_) {}
    }

    async function fetchRepo(card) {
      var repo = card.dataset.repo;
      if (!repo || readCache(repo, card)) return;

      var controller = window.AbortController ? new AbortController() : null;
      var timer = controller ? setTimeout(function() { controller.abort(); }, FETCH_TIMEOUT) : null;
      try {
        var res = await fetch(
          'https://api.github.com/repos/' + repo,
          {
            cache: 'force-cache',
            headers: { Accept: 'application/vnd.github.v3+json' },
            signal: controller ? controller.signal : undefined
          }
        );
        if (!res.ok) throw 0;
        var d = await res.json();
        var data = {
          stargazers_count: d.stargazers_count,
          language: d.language,
          topics: d.topics
        };
        updateCard(card, data);
        writeCache(repo, data);
      } catch (_) {}
      finally {
        if (timer) clearTimeout(timer);
      }
    }

    function idle(fn) {
      if ('requestIdleCallback' in window) requestIdleCallback(fn, { timeout: 1200 });
      else setTimeout(fn, 300);
    }

    function start(card) {
      if (card.dataset.githubMetaLoaded) return;
      card.dataset.githubMetaLoaded = 'true';
      idle(function() { fetchRepo(card); });
    }

    var cards = Array.prototype.slice.call(document.querySelectorAll('.project-card[data-repo]'));
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          observer.unobserve(entry.target);
          start(entry.target);
        });
      }, { rootMargin: '320px' });
      cards.forEach(function(card) { observer.observe(card); });
    } else {
      idle(function() { cards.forEach(start); });
    }
  })();
</script>
