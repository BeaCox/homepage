---
import type { ProjectItem } from '../config/sections';

interface Props {
  projects: ProjectItem[];
}

const { projects } = Astro.props;

const langColors: Record<string, string> = {
  Swift: '#F05138',
  TypeScript: '#3178C6',
  JavaScript: '#F7DF1E',
  Python: '#3572A5',
  Go: '#00ADD8',
  Rust: '#DEA584',
  C: '#555555',
  'C++': '#F34B7D',
  Java: '#B07219',
  Shell: '#89E051',
  Kotlin: '#A97BFF',
};

---

<div class="project-grid">
  {projects.map((p) => (
    <a
      class="project-card"
      href={`https://github.com/${p.repo}`}
      target="_blank"
      rel="noopener"
      data-repo={p.repo}
    >
      {p.logo && (
        <img
          class="project-logo"
          src={p.logo}
          alt={p.repo.split('/')[1]}
          width="48"
          height="48"
          loading="lazy"
        />
      )}
      <div class="project-body">
        <h3 class="project-name">
          {p.repo.split('/')[1]}
          <svg class="project-arrow" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17L17 7M17 7H8M17 7v9" />
          </svg>
        </h3>
        <div class="project-meta">
          <span class="project-stars">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
            </svg>
            <span data-stars>–</span>
          </span>
          {p.language && (
            <span class="project-lang">
              <span
                class="project-lang-dot"
                data-lang-dot
                style={`background:${langColors[p.language] || '#888'}`}
              />
              <span data-lang-name>{p.language}</span>
            </span>
          )}
        </div>
        <p class="project-desc">{p.description}</p>
        {p.topics.length > 0 && (
          <div class="project-topics" data-topics>
            {p.topics.slice(0, 4).map((t) => (
              <span class="project-topic">{t}</span>
            ))}
          </div>
        )}
      </div>
    </a>
  ))}
</div>

<script is:inline>
  (() => {
    const colors = {
      Swift:'#F05138',TypeScript:'#3178C6',JavaScript:'#F7DF1E',
      Python:'#3572A5',Go:'#00ADD8',Rust:'#DEA584',C:'#555555',
      'C++':'#F34B7D',Java:'#B07219',Shell:'#89E051',Kotlin:'#A97BFF'
    };
    function fmt(n) { return n >= 1000 ? (n/1000).toFixed(1)+'k' : String(n); }

    document.querySelectorAll('.project-card[data-repo]').forEach(async (card) => {
      var s = card.querySelector('[data-stars]');
      try {
        var res = await fetch(
          'https://api.github.com/repos/' + card.dataset.repo,
          { headers: { Accept: 'application/vnd.github.v3+json' } }
        );
        if (!res.ok) throw 0;
        var d = await res.json();

        if (s) s.textContent = fmt(d.stargazers_count);

        if (d.language) {
          var ln = card.querySelector('[data-lang-name]');
          var ld = card.querySelector('[data-lang-dot]');
          if (ln) ln.textContent = d.language;
          if (ld) ld.style.background = colors[d.language] || '#888';
        }

        var tp = card.querySelector('[data-topics]');
        if (tp && d.topics && d.topics.length) {
          tp.innerHTML = d.topics.slice(0, 4)
            .map(function(t) { return '<span class="project-topic">' + t + '</span>'; })
            .join('');
        }
      } catch (_) {
        if (s) s.textContent = '?';
      }
    });
  })();
</script>
