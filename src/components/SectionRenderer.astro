---
import type { PageSection } from '../config/sections';

interface Props {
  section: PageSection;
}

const { section } = Astro.props;
const Content = section.Content;
---

<section id={section.id} class="content-section" data-reveal data-section-id={section.id}>
  <header class="section-header">
    <h2>{section.title}</h2>
  </header>

  <div class:list={['markdown-content', `markdown-content--${section.kind}`]}>
    <Content />
  </div>
</section>
