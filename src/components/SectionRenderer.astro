---
import type { PageSection } from '../config/sections';
import ProjectCards from './ProjectCards.astro';

interface Props {
  section: PageSection;
}

const { section } = Astro.props;
const Content = section.Content;
---

<section id={section.id} class="content-section" data-reveal data-section-id={section.id}>
  <header class="section-header">
    <h2>{section.title}</h2>
  </header>

  {section.kind === 'projects' && section.projects ? (
    <ProjectCards projects={section.projects} />
  ) : (
    <div class:list={['markdown-content', `markdown-content--${section.kind}`]}>
      <Content />
    </div>
  )}
</section>
