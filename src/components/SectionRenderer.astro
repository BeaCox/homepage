---
import type { PageSection } from '../config/sections';
import ProjectCards from './ProjectCards.astro';

interface Props {
  section: PageSection;
}

const { section } = Astro.props;
const Content = section.Content;
---

<section id={section.id} class:list={['chapter', `chapter--${section.kind}`]} data-section>
  <header class="chapter-heading">
    <h2>
      {section.title}
      {section.disclosureCount !== undefined && <span class="disclosure-count">{section.disclosureCount}</span>}
    </h2>
    {section.subsections?.length && (
      <nav class="subsections" aria-label={section.title}>
        {section.subsections.map((sub) => <a href={`#${sub.id}`}>{sub.title}</a>)}
      </nav>
    )}
  </header>
  {section.kind === 'projects' && section.projects ? (
    <ProjectCards projects={section.projects} />
  ) : (
    <div class:list={['markdown-content', `markdown-content--${section.kind}`]}>
      <Content />
    </div>
  )}
</section>
